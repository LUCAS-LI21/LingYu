# 一键部署配置：复制为 .env 后按需修改
#   cp .env.deploy.example .env
# `.env` 已在 .gitignore 中，不会入库

# ---------- 数据库 ----------
# 生产必须改掉
MYSQL_ROOT_PASSWORD=<必须改成随机强口令>
DB_NAME=poi_intel

# ---------- 鉴权 ----------
# 生成方式：openssl rand -base64 32
# 留空则容器每次启动生成随机密钥，重启后所有 token 失效
AUTH_SECRET=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=<必须改成随机强口令；留空/默认值会导致后端拒绝启动>

# ---------- 抓取代理 ----------
# 容器里访问宿主机的代理必须用 host.docker.internal，不能写 127.0.0.1
# 本机无代理时留空（Java 直连 Overpass 常被 502）
INGEST_PROXY=http://host.docker.internal:7892

# ---------- L2 实时地址（可选）----------
# 高德 Web 服务 Key；只用于详情页「查实时地址」，不落库、不缓存
# 留空则该入口提示不可用，其余功能不受影响
AMAP_KEY=
# 每日预算闸门：总调用 / 周边搜索分别限流（个人认证搜索配额仅 5,000/月）
LIVE_DAILY_BUDGET=300
LIVE_DAILY_BUDGET_AROUND=100
LIVE_MIN_INTERVAL_MS=200

# ---------- 对外端口 ----------
# 前端访问地址 http://127.0.0.1:8081
WEB_PORT=8081
# 后端接口（仅本机可访问）http://127.0.0.1:18080/api/v1/health
API_PORT=18080
# MySQL（仅本机可访问），避开本机已有的 3306
MYSQL_PORT=3307

# ---------- 数据接入 Agent（可选）----------
# DeepSeek API Key；留空则 Agent 补全功能显示未启用
DEEPSEEK_API_KEY=

# ---------- HTTPS ----------
# 对外 HTTPS 端口映射（容器内 443，自签证书）
WEB_SSL_PORT=8443

# ---------- 数据库业务账号 ----------
# backend 用这个账号连库，不再用 root
DB_USER=poi
DB_PASSWORD=<必须改成随机强口令>
