# 复制为 .env.local 后按需修改（.env.local 不入库）
VITE_APP_TITLE=BISAI Agent

# 接口前缀：生产走同源 /api，由 Nginx 反代到后端
VITE_API_BASE_URL=/api
# 本地开发时 vite 代理转发目标（Spring Boot / NestJS 等）
VITE_API_PROXY=http://127.0.0.1:8080

# 错误监控：留空则自动降级为纯埋点模式
VITE_SENTRY_DSN=

# 埋点上报地址：留空则在开发环境只打印到控制台
VITE_ANALYTICS_ENDPOINT=

# 运营后台鉴权（生产必须设置 AUTH_SECRET）
AUTH_SECRET=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator123

# 高德 L2 实时层（ADR-0002）：必须是「Web服务」平台类型的 Key
# 留空则实时地址/实时周边自动降级为不可用，不影响本地库查询
AMAP_KEY=
# 每日预算闸门：总调用 / 周边搜索分别限流，防止误用打爆 5,000/月 的搜索配额
LIVE_DAILY_BUDGET=300
LIVE_DAILY_BUDGET_AROUND=100
LIVE_MIN_INTERVAL_MS=200
