.me-page {
  padding-top: 20rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.me-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #1e3a8a 0%, #2563eb 55%, #3b82f6 100%);
  box-shadow: 0 24rpx 54rpx rgba(37, 99, 235, 0.22);
}

.me-hero::before,
.me-hero::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.me-hero::before {
  width: 300rpx;
  height: 300rpx;
  right: -110rpx;
  top: -120rpx;
}

.me-hero::after {
  width: 180rpx;
  height: 180rpx;
  right: 90rpx;
  bottom: -100rpx;
  background: rgba(255, 255, 255, 0.06);
}

.hero-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-logo {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.hero-brand {
  display: block;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.hero-tagline {
  display: block;
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 32rpx;
  max-width: 560rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -1rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.hero-actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.hero-btn {
  min-height: 66rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 24rpx;
  line-height: 64rpx;
}

.hero-btn::after {
  border: none;
}

.hero-btn-primary {
  background: #fff;
  border-color: #fff;
  color: #1d4ed8;
  font-weight: 600;
}

.me-profile {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  padding: 28rpx;
}

.profile-avatar {
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #eff6ff, #dbeafe);
  color: #2563eb;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 78rpx;
  text-align: center;
}

.profile-name {
  display: block;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 650;
}

.profile-hint {
  display: block;
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 21rpx;
  line-height: 1.5;
}

.profile-field {
  margin-top: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #64748b;
  font-size: 22rpx;
}

.profile-input {
  width: 100%;
  height: 86rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 27rpx;
}

.profile-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}

.profile-note {
  color: #94a3b8;
  font-size: 20rpx;
}

.profile-actions .btn {
  min-width: 128rpx;
}

.me-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.card-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.card-title {
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 650;
}

.card-note {
  color: #94a3b8;
  font-size: 20rpx;
  text-align: right;
}

.service-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.service-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.service-icon {
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 66rpx;
  text-align: center;
}

.service-icon-warm {
  background: #fffbeb;
  color: #d97706;
}

.service-title {
  display: block;
  color: #1e293b;
  font-size: 27rpx;
  font-weight: 600;
}

.service-hint {
  display: block;
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 21rpx;
  line-height: 1.45;
}

.service-arrow {
  flex-shrink: 0;
  color: #cbd5e1;
  font-size: 34rpx;
  line-height: 1;
}

.operator-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 30rpx;
  padding: 16rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.operator-arrow {
  color: #cbd5e1;
  font-size: 28rpx;
}

.me-version {
  display: block;
  margin-top: 8rpx;
  color: #cbd5e1;
  font-size: 19rpx;
  text-align: center;
}
