.level-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.level-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e6eaf0;
  background: #f8fafc;
}

.level-l1 {
  border-color: #a7f3d0;
  background: #ecfdf5;
}

.level-l2 {
  border-color: #bfdbfe;
  background: #eff6ff;
}

.level-l3 {
  border-color: #e6eaf0;
  background: #f8fafc;
}

.level-code {
  width: 56rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #fff;
  color: #475569;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 44rpx;
  text-align: center;
}

.level-title {
  display: block;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 600;
}

.level-text {
  display: block;
  margin-top: 2rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.5;
}

.source-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.source-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.source-title {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 600;
}

.source-scope {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.forbid-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.forbid-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.forbid-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #fef2f2;
  color: #ef4444;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.forbid-name {
  display: block;
  color: #334155;
  font-size: 23rpx;
  font-weight: 500;
}

.forbid-reason {
  display: block;
  margin-top: 2rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.5;
}

.disclaimer-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.disclaimer-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.disclaimer-dot {
  width: 8rpx;
  height: 8rpx;
  flex-shrink: 0;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #94a3b8;
}
