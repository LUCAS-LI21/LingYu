.search-card {
  overflow: hidden;
}

.filter-pill {
  min-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e6eaf0;
  background: #fff;
  color: #475569;
  font-size: 23rpx;
  line-height: 62rpx;
}

.stat-metric {
  min-width: calc(50% - 7rpx);
  background: #fff;
  border: 1rpx solid #e6eaf0;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.stat-value {
  margin-top: 10rpx;
  font-size: 42rpx;
}

.bar-row {
  padding: 10rpx 0;
}

.bar-label {
  color: #334155;
  font-size: 24rpx;
}

.bar-value {
  color: #64748b;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.slim-bar {
  height: 9rpx;
}

.district-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.district-row:last-child {
  border-bottom: none;
}

.hot-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.hot-row:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hot-label {
  display: block;
  color: #334155;
  font-size: 24rpx;
  font-weight: 500;
}

.hot-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 19rpx;
}

.data-links {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.data-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.data-link-title {
  display: block;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

.stats-note {
  display: block;
  margin: 26rpx 6rpx 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.6;
}
