.pending-kpis {
  display: flex;
  gap: 12rpx;
}

.pending-kpi {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e6eaf0;
  background: #fff;
}

.pending-value {
  display: block;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 650;
}

.pending-label {
  display: block;
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 19rpx;
  line-height: 1.4;
}

.filter-pill {
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e6eaf0;
  background: #fff;
  color: #475569;
  font-size: 23rpx;
  line-height: 56rpx;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.pending-name {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-address {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.55;
}

.load-more {
  padding: 22rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 21rpx;
}
