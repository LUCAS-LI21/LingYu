/* 邻域 POI · 小程序设计基座
   色板/圆角/阴影与 Web 端保持一致，移动端用 rpx 重排 */

page {
  --bg: #f4f6f9;
  --surface: #ffffff;
  --surface-soft: #f8fafc;
  --ink-900: #0f172a;
  --ink-700: #334155;
  --ink-500: #64748b;
  --ink-400: #94a3b8;
  --line: #e6eaf0;
  --line-strong: #d7dde7;
  --brand: #2563eb;
  --brand-600: #1d4ed8;
  --brand-50: #eff6ff;
  --mint: #10b981;
  --mint-50: #ecfdf5;
  --amber: #f59e0b;
  --amber-50: #fffbeb;
  --red: #ef4444;
  --red-50: #fef2f2;
  background: var(--bg);
  color: var(--ink-900);
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.45;
}

view,
text,
button,
input,
textarea,
scroll-view,
map,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: none;
}

input,
textarea {
  font-family: inherit;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
}

.page-tab {
  padding-bottom: 36rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wrap {
  flex-wrap: wrap;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.grow {
  flex: 1;
  min-width: 0;
}

.gap-8 {
  gap: 8rpx;
}

.gap-12 {
  gap: 12rpx;
}

.gap-16 {
  gap: 16rpx;
}

.gap-20 {
  gap: 20rpx;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-12 {
  margin-top: 12rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-12 {
  margin-bottom: 12rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

/* ---------- 文本 ---------- */
.h1 {
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -0.5rpx;
  line-height: 1.25;
  color: var(--ink-900);
}

.h2 {
  font-size: 34rpx;
  font-weight: 650;
  letter-spacing: -0.3rpx;
  line-height: 1.3;
}

.h3 {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.body {
  font-size: 27rpx;
  color: var(--ink-700);
}

.muted {
  color: var(--ink-500);
  font-size: 24rpx;
}

.tiny {
  color: var(--ink-400);
  font-size: 21rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--ink-400);
  font-size: 21rpx;
  letter-spacing: 0.5rpx;
}

.strong {
  font-weight: 600;
  color: var(--ink-900);
}

.brand-text {
  color: var(--brand);
}

.mint-text {
  color: var(--mint);
}

.amber-text {
  color: var(--amber);
}

.red-text {
  color: var(--red);
}

.mono {
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---------- 卡片与分割 ---------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.05);
}

.card-pad {
  padding: 28rpx;
}

.card-flat {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.soft-box {
  background: var(--surface-soft);
  border-radius: 20rpx;
  padding: 20rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 16rpx;
}

.section-title {
  font-size: 29rpx;
  font-weight: 650;
  color: var(--ink-900);
}

.section-sub {
  font-size: 21rpx;
  color: var(--ink-400);
}

/* ---------- 品牌/头像 ---------- */
.logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.28);
}

.logo-sm {
  width: 46rpx;
  height: 46rpx;
  border-radius: 13rpx;
  font-size: 24rpx;
}

.brand-title {
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.brand-sub {
  display: block;
  margin-top: 2rpx;
  color: var(--ink-400);
  font-size: 19rpx;
  letter-spacing: 1.4rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  color: var(--ink-700);
  font-size: 26rpx;
  font-weight: 500;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.22);
}

.btn-mint {
  background: var(--mint);
  border-color: var(--mint);
  color: #fff;
}

.btn-ghost {
  background: var(--surface-soft);
  border-color: var(--line);
  color: var(--ink-700);
}

.btn-danger {
  background: var(--red-50);
  border-color: #fecaca;
  color: var(--red);
}

.btn-sm {
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.btn-block {
  width: 100%;
  display: flex;
}

.btn-disabled {
  opacity: 0.45;
}

.btn:active,
.tap:active {
  opacity: 0.82;
}

/* ---------- 输入 ---------- */
.input,
.textarea {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--ink-900);
  font-size: 27rpx;
}

.textarea {
  min-height: 180rpx;
  padding: 18rpx 22rpx;
  line-height: 1.55;
}

.input-placeholder,
.textarea-placeholder {
  color: var(--ink-400);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--surface);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  color: var(--ink-400);
  font-size: 30rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 27rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--ink-400);
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

/* ---------- 标签/胶囊 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--surface-soft);
  color: var(--ink-500);
  font-size: 21rpx;
  line-height: 1;
  white-space: nowrap;
}

.tag-brand {
  border-color: #bfdbfe;
  background: var(--brand-50);
  color: var(--brand-600);
}

.tag-mint {
  border-color: #a7f3d0;
  background: var(--mint-50);
  color: #047857;
}

.tag-amber {
  border-color: #fde68a;
  background: var(--amber-50);
  color: #b45309;
}

.tag-red {
  border-color: #fecaca;
  background: var(--red-50);
  color: #b91c1c;
}

.tag-gray {
  border-color: var(--line);
  background: var(--surface-soft);
  color: var(--ink-500);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
}

.dot-amber {
  background: var(--amber);
}

.dot-mint {
  background: var(--mint);
}

.chip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  white-space: nowrap;
}

.chip {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink-500);
  font-size: 24rpx;
  line-height: 58rpx;
}

.chip-active {
  border-color: var(--brand);
  background: var(--brand-50);
  color: var(--brand-600);
  font-weight: 600;
}

.chip-soft {
  background: var(--surface-soft);
}

.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--line);
}

.segmented-item {
  flex: 1;
  min-height: 58rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-500);
  font-size: 24rpx;
}

.segmented-active {
  background: var(--surface);
  color: var(--ink-900);
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
}

/* ---------- 指标 ---------- */
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.metric {
  flex: 1;
  min-width: 140rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
}

.metric-value {
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.2;
  color: var(--ink-900);
}

.metric-label {
  margin-top: 6rpx;
  color: var(--ink-400);
  font-size: 20rpx;
}

.metric-hint {
  margin-top: 4rpx;
  color: var(--ink-400);
  font-size: 19rpx;
}

/* ---------- 条形图 ---------- */
.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--brand);
}

.bar-fill-mint {
  background: var(--mint);
}

.bar-fill-amber {
  background: var(--amber);
}

.bar-fill-ink {
  background: #94a3b8;
}

/* ---------- 反馈/状态 ---------- */
.status {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--surface-soft);
  color: var(--ink-500);
  font-size: 20rpx;
}

.status-amber {
  border-color: #fde68a;
  background: var(--amber-50);
  color: #b45309;
}

.status-mint {
  border-color: #a7f3d0;
  background: var(--mint-50);
  color: #047857;
}

.status-red {
  border-color: #fecaca;
  background: var(--red-50);
  color: #b91c1c;
}

.status-brand {
  border-color: #bfdbfe;
  background: var(--brand-50);
  color: var(--brand-600);
}

/* ---------- 空状态/加载 ---------- */
.empty {
  padding: 70rpx 30rpx;
  text-align: center;
  color: var(--ink-400);
  font-size: 25rpx;
}

.empty-title {
  color: var(--ink-500);
  font-size: 27rpx;
  font-weight: 500;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 18rpx;
  border-radius: 26rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-400);
  font-size: 38rpx;
}

.skeleton {
  height: 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #eef2f7 25%, #f7f9fc 37%, #eef2f7 63%);
  background-size: 400% 100%;
  animation: skeleton 1.3s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.fade-up {
  animation: fade-up 0.32s ease both;
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- 底部浮层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.35);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  max-height: 82vh;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -20rpx 60rpx rgba(15, 23, 42, 0.16);
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #dbe2ec;
  margin: 14rpx auto 4rpx;
}

.sheet-body {
  max-height: 76vh;
  overflow-y: auto;
  padding: 20rpx 28rpx 30rpx;
}

.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}

/* ---------- 其他 ---------- */
.link {
  color: var(--brand-600);
  font-size: 24rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.scroll-x {
  width: 100%;
  white-space: nowrap;
}

.thumb {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-50);
  color: var(--brand-600);
  font-size: 30rpx;
  font-weight: 650;
}

.thumb-community {
  background: var(--amber-50);
  color: var(--amber);
}

.arrow {
  color: var(--ink-400);
  font-size: 30rpx;
  line-height: 1;
}

.notice {
  display: flex;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #fde68a;
  background: var(--amber-50);
  color: #92400e;
  font-size: 23rpx;
  line-height: 1.55;
}

.notice-brand {
  border-color: #bfdbfe;
  background: var(--brand-50);
  color: #1e40af;
}

.notice-mint {
  border-color: #a7f3d0;
  background: var(--mint-50);
  color: #047857;
}

.notice-red {
  border-color: #fecaca;
  background: var(--red-50);
  color: #b91c1c;
}

.safe-area {
  height: env(safe-area-inset-bottom);
}

/* 表格化信息行 */
.kv-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-key {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--ink-400);
  font-size: 24rpx;
}

.kv-value {
  flex: 1;
  min-width: 0;
  color: var(--ink-700);
  font-size: 25rpx;
  word-break: break-all;
}
