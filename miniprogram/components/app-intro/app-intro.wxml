<view class="intro {{leaving ? 'intro-leaving' : ''}}" bindtap="skip">
  <view class="intro-glow"></view>
  <view class="intro-ring intro-ring-1"></view>
  <view class="intro-ring intro-ring-2"></view>

  <view
    wx:for="{{particles}}"
    wx:key="left"
    class="intro-particle"
    style="left: {{item.left}}%; top: {{item.top}}%; width: {{item.size}}rpx; height: {{item.size}}rpx; animation-delay: {{item.delay}}ms;"
  ></view>

  <view class="intro-content">
    <view class="intro-logo">邻</view>
    <text class="intro-name">邻域</text>
    <text class="intro-tagline">深圳银行网点与小区情报</text>
    <text class="intro-hint">正在为你展开城市数据</text>
  </view>

  <view class="intro-footer">
    <view class="intro-progress"><view class="intro-progress-bar"></view></view>
    <text class="intro-skip">轻触跳过</text>
  </view>
</view>
