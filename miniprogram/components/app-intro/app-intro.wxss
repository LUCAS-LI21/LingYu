.intro {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 42%, rgba(37, 99, 235, 0.28), transparent 45%),
    radial-gradient(circle at 20% 10%, rgba(14, 165, 233, 0.16), transparent 38%),
    #08111f;
  transition:
    opacity 0.22s ease,
    visibility 0.22s ease;
}

.intro-leaving {
  opacity: 0;
  visibility: hidden;
}

.intro-glow {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 380rpx;
  height: 380rpx;
  margin-left: -190rpx;
  margin-top: -190rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.2), transparent 68%);
  animation: glow 2.2s ease-in-out infinite;
}

.intro-ring {
  position: absolute;
  left: 50%;
  top: 44%;
  border: 1rpx solid rgba(147, 197, 253, 0.16);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: ring 2.6s ease-out infinite;
}

.intro-ring-1 {
  width: 430rpx;
  height: 430rpx;
}

.intro-ring-2 {
  width: 600rpx;
  height: 600rpx;
  animation-delay: 0.45s;
}

.intro-particle {
  position: absolute;
  border-radius: 50%;
  background: #bfdbfe;
  box-shadow: 0 0 14rpx rgba(96, 165, 250, 0.8);
  animation: twinkle 1.5s ease-in-out infinite;
}

.intro-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: rise 0.7s ease both;
}

.intro-logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #3b82f6, #1d4ed8);
  box-shadow:
    0 20rpx 50rpx rgba(37, 99, 235, 0.35),
    0 0 0 1rpx rgba(191, 219, 254, 0.25);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.intro-name {
  margin-top: 26rpx;
  color: #f8fafc;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.intro-tagline {
  margin-top: 8rpx;
  color: rgba(226, 232, 240, 0.72);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.intro-hint {
  margin-top: 34rpx;
  color: rgba(147, 197, 253, 0.72);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.intro-footer {
  position: absolute;
  left: 50%;
  bottom: calc(72rpx + env(safe-area-inset-bottom));
  width: 300rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.intro-progress {
  width: 100%;
  height: 4rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(148, 197, 253, 0.16);
}

.intro-progress-bar {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #38bdf8, #60a5fa);
  transform-origin: left center;
  animation: progress 1.5s ease-out forwards;
}

.intro-skip {
  margin-top: 14rpx;
  color: rgba(148, 163, 184, 0.65);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes progress {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@keyframes twinkle {
  0%,
  100% {
    opacity: 0.2;
    transform: scale(0.8);
  }
  50% {
    opacity: 1;
    transform: scale(1.25);
  }
}

@keyframes glow {
  0%,
  100% {
    opacity: 0.5;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.06);
  }
}

@keyframes ring {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.72);
  }
  30% {
    opacity: 0.7;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.18);
  }
}
